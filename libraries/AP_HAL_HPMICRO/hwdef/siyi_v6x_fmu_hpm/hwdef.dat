# Toolchain Path
env TOOLCHAIN riscv32-unknown-elf
env HPM_SDK_TOOLCHAIN_VARIANT gcc
env GNURISCV_TOOLCHAIN_PATH riscv32-gnu-toolchain/
env HPM_SOC_SERIES   HPM6700
define HAL_CANFD_SUPPORTED         1
# Board Definitions
define AP_BARO_ICP201XX_ENABLED    1
define HAL_HPMICRO_SDCARD          1
define AP_FILESYSTEM_FATFS_ENABLED 1
define HAL_HPM_BOARD_NAME "siyi_v6x_fmu_hpm"
define DEFAULT_SERIAL0_PROTOCOL        SerialProtocol_MAVLink2
define DEFAULT_SERIAL0_BAUD            921600

define DEFAULT_SERIAL1_PROTOCOL        SerialProtocol_None
define DEFAULT_SERIAL1_BAUD            1500000

define DEFAULT_SERIAL2_PROTOCOL        SerialProtocol_RCIN
define DEFAULT_SERIAL2_BAUD            416666

define DEFAULT_SERIAL3_PROTOCOL        SerialProtocol_GPS
define DEFAULT_SERIAL3_BAUD            AP_SERIALMANAGER_GPS_BAUD 

CAN_ORDER 0 IOC_PAD_PA19 IOC_PAD_PA20 IOC_PA19_FUNC_CTL_CAN1_RXD 0 0 IOC_PA20_FUNC_CTL_CAN1_TXD 0 0 IRQn_CAN1 clock_can1
CAN_ORDER 1 IOC_PAD_PA24 IOC_PAD_PA25 IOC_PA24_FUNC_CTL_CAN2_RXD 0 0 IOC_PA25_FUNC_CTL_CAN2_TXD 0 0 IRQn_CAN2 clock_can2
CAN_ORDER 2 IOC_PAD_PA29 IOC_PAD_PA30 IOC_PA29_FUNC_CTL_CAN3_RXD 0 0 IOC_PA30_FUNC_CTL_CAN3_TXD 0 0 IRQn_CAN3 clock_can3

define HAL_WITH_SPI_OSD                    1
define AP_FILESYSTEM_FILE_WRITING_ENABLED  1
define HAL_LOGGING_ENABLED            1
define HAL_LOGGING_FILESYSTEM_ENABLED 1
define HAL_LOGGING_DATAFLASH_ENABLED 0
define HAL_LOGGING_MAVLINK_ENABLED 0
define HAL_LOGGING_BACKENDS_DEFAULT 2
define AP_NOTIFY_GPIO_LED_3_ENABLED 1

define HAL_GPIO_A_LED_PIN 0
define HAL_GPIO_B_LED_PIN 1
define HAL_GPIO_C_LED_PIN 2
HPMICRO_GPIO 0 IOC_PAD_PB05 true 0 0 nullptr
HPMICRO_GPIO 1 IOC_PAD_PB09 true 0 0 nullptr
HPMICRO_GPIO 2 IOC_PAD_PB12 true 0 0 nullptr


HPMICRO_SERIAL HPM_UART1 clock_uart1 IOC_PAD_PC18 IOC_PAD_PC19 IOC_PC18_FUNC_CTL_UART1_RXD IOC_PC19_FUNC_CTL_UART1_TXD 0 0 0 0 IRQn_UART1 1
HPMICRO_SERIAL HPM_UART0 clock_uart0 IOC_PAD_PY07 IOC_PAD_PY06 IOC_PY07_FUNC_CTL_UART0_RXD IOC_PY06_FUNC_CTL_UART0_TXD 0 0 PIOC_PY07_FUNC_CTL_SOC_PY_07 PIOC_PY06_FUNC_CTL_SOC_PY_06 IRQn_UART0 0
HPMICRO_SERIAL HPM_UART2 clock_uart2 IOC_PAD_PC23 IOC_PAD_PC24 IOC_PC23_FUNC_CTL_UART2_RXD IOC_PC24_FUNC_CTL_UART2_TXD 0 0 0 0 IRQn_UART2 2
HPMICRO_SERIAL HPM_UART3 clock_uart3 IOC_PAD_PC30 IOC_PAD_PC31 IOC_PC30_FUNC_CTL_UART3_RXD IOC_PC31_FUNC_CTL_UART3_TXD 0 0 0 0 IRQn_UART3 3
HPMICRO_SERIAL HPM_UART6 clock_uart6 IOC_PAD_PC27 IOC_PAD_PC28 IOC_PC27_FUNC_CTL_UART6_RXD IOC_PC28_FUNC_CTL_UART6_TXD 0 0 0 0 IRQn_UART6 6 IOC_PAD_PD09 IOC_PAD_PD10 IOC_PD09_FUNC_CTL_UART6_CTS IOC_PD10_FUNC_CTL_UART6_RTS 0 0 0 0
HPMICRO_SERIAL HPM_UART8 clock_uart8 IOC_PAD_PC06 IOC_PAD_PC07 IOC_PC06_FUNC_CTL_UART8_RXD IOC_PC07_FUNC_CTL_UART8_TXD 0 0 0 0 IRQn_UART8 8 IOC_PAD_PD11 IOC_PAD_PD14 IOC_PD11_FUNC_CTL_UART8_CTS IOC_PD14_FUNC_CTL_UART8_RTS 0 0 0 0
HPMICRO_SERIAL HPM_UART9 clock_uart9 IOC_PAD_PC11 IOC_PAD_PC12 IOC_PC11_FUNC_CTL_UART9_RXD IOC_PC12_FUNC_CTL_UART9_TXD 0 0 0 0 IRQn_UART9 9 IOC_PAD_PA12 IOC_PAD_PA13 IOC_PA12_FUNC_CTL_UART9_CTS IOC_PA13_FUNC_CTL_UART9_RTS 0 0 0 0
HPMICRO_SERIAL HPM_UART5 clock_uart5 IOC_PAD_PD06 IOC_PAD_PD07 IOC_PD06_FUNC_CTL_UART5_RXD IOC_PD07_FUNC_CTL_UART5_TXD 0 0 0 0 IRQn_UART5 5

HPMICRO_SPIBUS HPM_SPI0 clock_spi0 HPM_HDMA IRQn_HDMA 0 HPM_DMA_SRC_SPI0_TX 1 HPM_DMA_SRC_SPI0_RX IOC_PAD_PZ04 IOC_PAD_PZ05 IOC_PAD_PZ03 IOC_PZ04_FUNC_CTL_SPI0_MOSI IOC_PZ05_FUNC_CTL_SPI0_MISO IOC_PZ03_FUNC_CTL_SPI0_SCLK BIOC_PZ04_FUNC_CTL_SOC_PZ_04 BIOC_PZ05_FUNC_CTL_SOC_PZ_05 IOC_PZ03_FUNC_CTL_SPI0_SCLK|IOC_PAD_FUNC_CTL_LOOP_BACK_MASK 0 0 0
HPMICRO_SPIBUS HPM_SPI1 clock_spi1 HPM_HDMA IRQn_HDMA 2 HPM_DMA_SRC_SPI1_TX 3 HPM_DMA_SRC_SPI1_RX IOC_PAD_PA16 IOC_PAD_PA23 IOC_PAD_PA21 IOC_PA16_FUNC_CTL_SPI1_MOSI IOC_PA23_FUNC_CTL_SPI1_MISO IOC_PA21_FUNC_CTL_SPI1_SCLK 0 0 IOC_PAD_FUNC_CTL_LOOP_BACK_MASK 0 0 0
HPMICRO_SPIBUS HPM_SPI2 clock_spi2 HPM_HDMA IRQn_HDMA 4 HPM_DMA_SRC_SPI2_TX 5 HPM_DMA_SRC_SPI2_RX IOC_PAD_PA27 IOC_PAD_PA31 IOC_PAD_PB00 IOC_PA27_FUNC_CTL_SPI2_MOSI IOC_PA31_FUNC_CTL_SPI2_MISO IOC_PB00_FUNC_CTL_SPI2_SCLK 0 0 IOC_PAD_FUNC_CTL_LOOP_BACK_MASK 0 0 0
HPMICRO_SPIBUS HPM_SPI3 clock_spi3 HPM_HDMA IRQn_HDMA 6 HPM_DMA_SRC_SPI3_TX 7 HPM_DMA_SRC_SPI3_RX IOC_PAD_PY00 IOC_PAD_PY01 IOC_PAD_PY02 IOC_PY00_FUNC_CTL_SPI3_MOSI IOC_PY01_FUNC_CTL_SPI3_MISO IOC_PY02_FUNC_CTL_SPI3_SCLK PIOC_PY00_FUNC_CTL_SOC_PY_00 PIOC_PY01_FUNC_CTL_SOC_PY_01 PIOC_PY02_FUNC_CTL_SOC_PY_02|IOC_PAD_FUNC_CTL_LOOP_BACK_MASK 0 0 0
HPMICRO_SPIDEV bmi088_g    1 0  IOC_PAD_PC10   IOC_PC10_FUNC_CTL_GPIO_C_10 0 0 3 1*MHZ  10*MHZ
HPMICRO_SPIDEV bmi088_a    1 1  IOC_PAD_PB02   IOC_PB02_FUNC_CTL_GPIO_B_02 0 0 3 1*MHZ  10*MHZ
HPMICRO_SPIDEV icm45686    2 0  IOC_PAD_PC20   IOC_PC20_FUNC_CTL_GPIO_C_20 0 0 3 1*MHZ  10*MHZ

HPMICRO_I2CBUS HPM_I2C0 IOC_PAD_PB10 IOC_PAD_PB11 IOC_PB10_FUNC_CTL_I2C0_SDA IOC_PB11_FUNC_CTL_I2C0_SCL 0 0 3 3 clock_i2c0 400*KHZ true false
HPMICRO_I2CBUS HPM_I2C1 IOC_PAD_PD08 IOC_PAD_PD05 IOC_PD08_FUNC_CTL_I2C1_SDA IOC_PD05_FUNC_CTL_I2C1_SCL 0 0 3 3 clock_i2c1 400*KHZ true false
HPMICRO_I2CBUS HPM_I2C2 IOC_PAD_PB03 IOC_PAD_PB04 IOC_PB03_FUNC_CTL_I2C2_SDA IOC_PB04_FUNC_CTL_I2C2_SCL 0 0 3 3 clock_i2c2 400*KHZ true false
HPMICRO_I2CBUS HPM_I2C3 IOC_PAD_PB13 IOC_PAD_PB14 IOC_PB13_FUNC_CTL_I2C3_SDA IOC_PB14_FUNC_CTL_I2C3_SCL 0 0 3 3 clock_i2c3 400*KHZ true false

HPMICRO_ADCPIN 15 1.75f 0 IOC_PAD_PE29 false HPM_ADC0 clock_adc0
HPMICRO_ADCPIN 16 1.75f 0 IOC_PAD_PE30 false HPM_ADC0 clock_adc0
define AP_SERIALMANAGER_ENABLED    1
define AP_INERTIALSENSOR_ENABLED   1
define AP_COMPASS_ENABLE_DEFAULT   0
define ALLOW_ARM_NO_COMPASS
define AP_RCPROTOCOL_ENABLED       1
define AP_MOTORS_FRAME_DEFAULT_ENABLED 0
define AP_MOTORS_FRAME_QUAD_ENABLED 1

define HPM_ADC_SAMPLE_CYCLE 20
define HPM_ADC_PRESCALE_VALUE 22
define HPM_ADC_PERIOD_COUNT 5

define HPM_SPI_TIMEOUT_VALUE 0xFFFFFFFF

HPMICRO_RCOUT IOC_PAD_PD00 2
HPMICRO_RCOUT IOC_PAD_PD01 3
HPMICRO_RCOUT IOC_PAD_PD02 4
HPMICRO_RCOUT IOC_PAD_PC29 7

AUTOBUILD_TARGETS Copter
